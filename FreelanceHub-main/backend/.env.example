# Neon PostgreSQL connection string. Use the pooled URL for deployed web workloads.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
PORT=5000
# Optional trusted reverse proxy hops (Render uses 1 in production).
TRUST_PROXY=0
NODE_ENV="development"

# Optional: set BOTH values to create the first administrator.
# Use a unique email and a password of at least 12 characters.
# Existing administrator credentials and account status are never reset by seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
