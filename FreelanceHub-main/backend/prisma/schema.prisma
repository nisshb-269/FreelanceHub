generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  ACTIVE
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum TeamMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum TeamTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum NotificationType {
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  CONTRACT_CREATED
  WORK_SUBMITTED
  REVISION_REQUESTED
  PROJECT_COMPLETED
  NEW_MESSAGE
  NEW_REVIEW
  SYSTEM
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  passwordHash      String
  role              UserRole
  avatarUrl         String?
  bio               String?             @db.Text
  location          String?
  website           String?
  isVerified        Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  clientProjects    Project[]           @relation("ClientProjects")
  proposals         Proposal[]
  clientContracts   Contract[]          @relation("ClientContracts")
  freelancerContracts Contract[]        @relation("FreelancerContracts")
  sentMessages      Message[]           @relation("SentMessages")
  receivedMessages  Message[]           @relation("ReceivedMessages")
  notifications     Notification[]
  reviewsGiven      Review[]             @relation("ReviewsGiven")
  reviewsReceived   Review[]             @relation("ReviewsReceived")
  savedProjects     SavedProject[]
  transactions      Transaction[]
  openedDisputes    Dispute[]             @relation("DisputeOpener")
  uploadedDeliverables Deliverable[]
  projectMemberships ProjectMember[] @relation("TeamMemberFreelancer")
  sentTeamInvitations ProjectMember[] @relation("TeamMemberInviter")
  assignedTeamTasks ProjectTask[] @relation("ProjectTaskAssignee")
  createdTeamTasks ProjectTask[] @relation("ProjectTaskCreator")
  sentTeamMessages ProjectMessage[] @relation("TeamMessageSender")
}

model FreelancerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  headline       String?
  skills         String[] @default([])
  hourlyRate     Decimal? @db.Decimal(10, 2)
  experience     String?
  portfolioUrl   String?
  availability   String   @default("Available")
  totalEarnings  Decimal  @default(0) @db.Decimal(12, 2)
  completedJobs  Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  industry    String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  description String        @db.Text
  category    String
  skills      String[]      @default([])
  budgetMin   Decimal       @db.Decimal(10, 2)
  budgetMax   Decimal       @db.Decimal(10, 2)
  deadline    DateTime?
  teamEnabled Boolean       @default(false)
  teamSize    Int           @default(1)
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      User          @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  proposals   Proposal[]
  contract    Contract?
  savedBy     SavedProject[]
  teamMembers ProjectMember[]
  teamTasks   ProjectTask[]
  teamMessages ProjectMessage[]
  @@index([status, createdAt])
  @@index([category])
}


model ProjectMember {
  id          String           @id @default(cuid())
  projectId   String
  freelancerId String
  invitedById String
  roleLabel   String           @default("Contributor")
  status      TeamMemberStatus @default(PENDING)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer  User             @relation("TeamMemberFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("TeamMemberInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
  @@index([freelancerId, status])
  @@index([projectId, status])
}

model ProjectTask {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?        @db.Text
  assigneeId  String?
  createdById String
  status      TeamTaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("ProjectTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([assigneeId, status])
}


model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation("TeamMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Proposal {
  id                String         @id @default(cuid())
  projectId         String
  freelancerId      String
  coverLetter       String         @db.Text
  bidAmount         Decimal        @db.Decimal(10, 2)
  deliveryDays      Int
  status            ProposalStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer        User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  contract          Contract?
  @@unique([projectId, freelancerId])
  @@index([freelancerId, status])
}

model Contract {
  id           String         @id @default(cuid())
  projectId    String         @unique
  proposalId   String         @unique
  clientId     String
  freelancerId String
  amount       Decimal        @db.Decimal(10, 2)
  startDate    DateTime       @default(now())
  dueDate      DateTime?
  status       ContractStatus @default(ACTIVE)
  submittedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposal     Proposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client       User           @relation("ClientContracts", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer   User           @relation("FreelancerContracts", fields: [freelancerId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
  messages     Message[]
  reviews      Review[]
  transactions Transaction[]
  disputes     Dispute[]
  deliverables Deliverable[]
}

model Milestone {
  id          String          @id @default(cuid())
  contractId  String
  title       String
  description String?         @db.Text
  amount      Decimal         @db.Decimal(10, 2)
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  contractId  String?
  content     String   @db.Text
  readAt      DateTime?
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  @@index([senderId, receiverId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  contractId String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  @@unique([contractId, reviewerId])
}

model SavedProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  contractId  String
  amount      Decimal           @db.Decimal(10, 2)
  currency    String            @default("INR")
  status      TransactionStatus @default(PENDING)
  reference   String?           @unique
  description String?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String   @id @default(cuid())
  contractId  String
  openedById  String
  subject     String
  description String   @db.Text
  status      String   @default("OPEN")
  resolution  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedBy    User     @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Cascade)
}

model Deliverable {
  id         String   @id @default(cuid())
  contractId String
  uploaderId String
  fileName   String
  mimeType   String
  fileSize   Int
  fileData   Bytes
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  @@index([contractId, createdAt])
}
